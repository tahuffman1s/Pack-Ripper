# Copy to .env NEXT TO compose.yml on the VM and edit. Compose reads it
# automatically; nothing here is baked into the image.
#
#   cp .env.example .env && vi .env && docker compose up -d

# ── The public name ────────────────────────────────────────────
# Required, and there is no sensible default. Caddy puts this on a certificate
# and the app uses it as ORIGIN, so it must be a real hostname whose A record
# points at this VM's public IP — an IP address will not work for either. A free
# DuckDNS subdomain is fine.
DOMAIN=packripper.example.com

# ── Which build to run ─────────────────────────────────────────
# `latest` follows main. Pin the immutable sha- tag from the build's Actions
# summary when you want to know exactly what is running, and to make a rollback
# a matter of changing one line here.
TAG=latest

# ── Admin ──────────────────────────────────────────────────────
# Empty means the door is OFF rather than unlocked. A fresh database has no
# admins and nothing in the UI can promote the first one, so without
# ADMIN_USERNAMES the hosted copy has no way to appoint one.
#ADMIN_USERNAMES=travis

# Shared secret for the admin CLI. Generate one with `./admin.sh token` on your
# own machine, or `openssl rand -hex 32` here.
#ADMIN_TOKEN=

# ── Misc ───────────────────────────────────────────────────────
BODY_SIZE_LIMIT=2M
