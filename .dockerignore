# Never let these into an image layer.
#
# .data holds real password hashes, salts and live session tokens for every
# registered account. Baking it into an image would ship those to wherever the
# image goes — it is bind-mounted at runtime instead.
.data

# ~105 MB of Scryfall pools/prints, MTGJSON collation slices and TCGplayer
# sealed prices. Regenerated data with its own TTLs, not source. Bind-mounted so
# a rebuilt image keeps a warm cache.
.cache

node_modules
build
.svelte-kit
package

.git
.gitignore

# The container needs neither, and both change on every commit — keeping them
# out means an edit to the README does not invalidate the npm ci layer.
README.md
scripts
# …except the admin CLI, which the runtime stage copies to /app/admin.mjs so it
# can be run with `exec` on a host that has no checkout, and the two shell
# scripts the image's ENTRYPOINT and HEALTHCHECK are.
!scripts/admin.mjs
!scripts/docker-entrypoint.sh
!scripts/docker-healthcheck.sh

.env
.env.*
!.env.example

Dockerfile
.dockerignore
docker-compose.yml
run.sh

# CI config and the per-host compose files. Neither is part of the app, and both
# change without the image needing to.
.github
deploy

*.log
*.save
*~
.vscode
.idea
.DS_Store
