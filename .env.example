# Copy to .env and edit. run.sh and docker-compose.yml both read it, for running
# the app on THIS machine. .env is gitignored; .env.example is the one that is
# committed.
#
# Public hosting is a Raspberry Pi behind a Cloudflare Tunnel, and nothing there
# reads this file — deploy/pi/ has its own .env, with the variables that only
# matter there (DOMAIN, TUNNEL_TOKEN, DB_DIR).

# ── Where the app listens on the host ──────────────────────────
PORT=3000

# ── Database ───────────────────────────────────────────────────
# Every account lives in Postgres. run.sh and docker-compose.yml each start one
# for you, so there is nothing to install; these are the credentials they create
# it with. Defaulted because that database is published to loopback only.
#
# They are read ONLY when the data directory is first initialised. Changing them
# later needs the volume recreated — `./run.sh reset`, or `docker compose down -v`.
#POSTGRES_USER=packripper
#POSTGRES_PASSWORD=packripper
#POSTGRES_DB=packripper

# Host port Postgres is published on, for psql and scripts/import-json-db.js.
# Only worth changing if 5432 is already taken on this machine.
#PGPORT=5432

# Set this ONLY to point the app at a Postgres you manage yourself. Left unset,
# run.sh and compose build it from the variables above, aimed at the container
# they started.
#DATABASE_URL=postgres://user:password@host:5432/packripper

# For a managed provider that requires TLS but presents a certificate this app has
# no CA bundle for. It disables verification, so it is opt-in and never a default.
#PGSSLMODE=no-verify

# ── Admin ──────────────────────────────────────────────────────
# Both are empty by default, and empty means the door is OFF rather than
# unlocked.

# Accounts that are admins no matter what the database says, comma-separated.
# This is the bootstrap: a fresh database has no admins and nothing in the UI can
# promote the first one. Named accounts get the panel at /admin from their next
# sign-in, whether they exist yet or not.
#ADMIN_USERNAMES=travis

# Shared secret for ./admin.sh. Unset, the CLI cannot authenticate and the panel
# is the only way in. Generate one with `./admin.sh token`.
#ADMIN_TOKEN=

# ── Running the published image ────────────────────────────────
# Unset, run.sh builds the image locally. Set this and it pulls the one GitHub
# Actions publishes instead — the same image the Pi runs, which is the point of
# testing with it.
#IMAGE=ghcr.io/tahuffman1s/pack-ripper:latest

# ── Misc ───────────────────────────────────────────────────────
# Largest request body adapter-node will accept.
BODY_SIZE_LIMIT=2M

# Skip importing a legacy .data/db.json on first boot. The import only ever runs
# against a database that has no accounts, so it is already a no-op once it has
# happened — this is for deliberately starting empty with the old file still
# sitting there.
#IMPORT_LEGACY_JSON=0
