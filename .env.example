# Copy to .env and edit. run.sh and docker-compose.yml both read it, for running
# the app on THIS machine. .env is gitignored; .env.example is the one that is
# committed.
#
# Public hosting is Azure Container Apps, and nothing there reads this file — that
# container's environment is set on the app in the Portal, including the ORIGIN
# that has to match its real https:// hostname.

# ── Where the app listens on the host ──────────────────────────
PORT=3000

# ── Running the published image ────────────────────────────────
# Unset, run.sh builds the image locally. Set this and it pulls the one GitHub
# Actions publishes instead — the same image Azure runs, which is the point of
# testing with it.
#IMAGE=ghcr.io/tahuffman1s/pack-ripper:latest

# ── Admin ──────────────────────────────────────────────────────
# Both are empty by default, and empty means the door is OFF rather than
# unlocked. Set them in the Portal too for the hosted app — the container reads
# these, not this file.

# Accounts that are admins no matter what the database says, comma-separated.
# This is the bootstrap: a fresh database has no admins and nothing in the UI can
# promote the first one. Named accounts get the panel at /admin from their next
# sign-in, whether they exist yet or not.
#ADMIN_USERNAMES=travis

# Shared secret for ./admin.sh. Unset, the CLI cannot authenticate and the panel
# is the only way in. Generate one with `./admin.sh token`.
#ADMIN_TOKEN=

# ── Misc ───────────────────────────────────────────────────────
# Largest request body adapter-node will accept.
BODY_SIZE_LIMIT=2M

# ── Azure ──────────────────────────────────────────────────────
# Nothing to set here. The hosted app's image, port, volume and environment are
# configured on the Container App itself; the README lists the values, and every
# build's summary in Actions prints the image and tag to paste into the Portal.
