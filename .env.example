# Copy to .env and edit. run.sh and docker-compose.yml both read it.
# .env is gitignored; .env.example is the one that is committed.

# ── Where the app listens on the host ──────────────────────────
# Only used for direct access (./run.sh local). Through the tunnel, traffic
# reaches the container on 3000 regardless of this.
PORT=3000

# ── Cloudflare tunnel ──────────────────────────────────────────
# Leave the token empty for a QUICK TUNNEL: cloudflared prints a random
# https://<something>.trycloudflare.com URL, no Cloudflare account needed. Good
# for showing someone the app for an afternoon; the URL dies with the container.
#
# Caveat worth knowing before you conclude the tunnel is broken: the hostname
# cloudflared prints does not resolve yet. Its DNS record lands ten to forty
# seconds later. Look it up before then — open it in a browser, curl it — and the
# NXDOMAIN you get back is cached for the zone's 1800s negative TTL, so the URL
# stays dead for half an hour on your machine while working for everyone else.
# run.sh waits for the record before printing the URL. If you hit this anyway,
# restarting gets a fresh hostname; that is faster than waiting it out.
#
# For a STABLE hostname, create a tunnel in the Cloudflare dashboard
# (Zero Trust -> Networks -> Tunnels -> Create -> Cloudflared), point its public
# hostname at http://packripper:3000, and paste the connector token here.
CLOUDFLARE_TUNNEL_TOKEN=

# The public URL of that named tunnel, e.g. https://packripper.example.com
#
# Worth getting right: SvelteKit rejects any POST whose Origin header does not
# match the origin it thinks it is serving, so a wrong value here means every
# login and every purchase fails with "Cross-site POST form submissions are
# forbidden". Setting it pins the answer. Left empty, the app derives the origin
# from the x-forwarded-proto / x-forwarded-host headers Cloudflare sends, which
# is what makes a random quick-tunnel URL work with no configuration at all.
PUBLIC_URL=

# ── The GitHub Pages redirector ────────────────────────────────
# https://tahuffman1s.github.io/Pack-Ripper/ is a permanent link that forwards to
# whatever the tunnel currently is. It works by reading status.json off the
# `pages` branch, and run.sh is what writes that file — on every up, down and
# URL change.
#
# Leave GITHUB_TOKEN empty and nothing is published: run.sh prints the tunnel URL
# and says so, everything else works as before.
#
# To switch it on, make a fine-grained personal access token
# (github.com/settings/personal-access-tokens/new) scoped to this one repository,
# with Repository permissions -> Contents: Read and write. Nothing else. That is
# enough to commit status.json and cannot touch anything outside the repo.
GITHUB_TOKEN=

# Only if you forked or renamed. PAGES_BRANCH must match the branch Pages serves
# (Settings -> Pages -> Deploy from a branch).
#GITHUB_REPO=tahuffman1s/Pack-Ripper
#PAGES_BRANCH=pages

# How often the background watcher (./run.sh up --watch) re-checks. It publishes
# only when the answer changes, so an idle watcher writes nothing.
#WATCH_INTERVAL=30

# ── Running the published image ────────────────────────────────
# Set this to run the image GitHub Actions built instead of building locally.
# `./run.sh pull` fetches it; `./run.sh` then starts it without a build. If the
# package is private, log in first:
#   echo "$GITHUB_TOKEN" | podman login ghcr.io -u <your-username> --password-stdin
#IMAGE=ghcr.io/tahuffman1s/pack-ripper:latest

# ── Misc ───────────────────────────────────────────────────────
# Largest request body adapter-node will accept.
BODY_SIZE_LIMIT=2M
