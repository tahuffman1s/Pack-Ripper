# Copy to .env and edit. run.sh and docker-compose.yml both read it, for running
# the app on THIS machine. .env is gitignored; .env.example is the one that is
# committed.
#
# Public hosting is Azure Container Apps, and nothing there reads this file — the
# container's environment is set in azure/deploy.sh, which is also where ORIGIN
# gets pinned to the real https:// hostname.

# ── Where the app listens on the host ──────────────────────────
PORT=3000

# ── Running the published image ────────────────────────────────
# Unset, run.sh builds the image locally. Set this and it pulls the one GitHub
# Actions publishes instead — the same image Azure runs, which is the point of
# testing with it.
#IMAGE=ghcr.io/tahuffman1s/pack-ripper:latest

# ── Misc ───────────────────────────────────────────────────────
# Largest request body adapter-node will accept.
BODY_SIZE_LIMIT=2M

# ── Azure ──────────────────────────────────────────────────────
# azure/deploy.sh reads its settings from the environment, not from here, so pass
# them on the command line when you want to change one:
#
#   LOCATION=westeurope azure/deploy.sh
#   IMAGE=ghcr.io/tahuffman1s/pack-ripper:sha-abc1234 azure/deploy.sh
#
# Defaults: RG=packripper-rg LOCATION=eastus APP=packripper CPU=0.5 MEMORY=1.0Gi
